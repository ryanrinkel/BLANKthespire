# web/.env.example — copy to web/.env and fill with your own values. NEVER commit web/.env.
# Every variable below is read by web/app.py, web/auth.py, web/billing.py, web/db.py or web/forge.py.

# ── Core Flask ───────────────────────────────────────────────────────
BTSWEB_SECRET_KEY=change-me-to-a-long-random-string     # REQUIRED in prod: app fails closed if unset when OAuth is configured
BTSWEB_SECURE_COOKIES=1                                  # 1 in production (TLS); 0 for local http
BTSWEB_BEHIND_PROXY=1                                    # 1 when behind nginx (trusts X-Forwarded-*)
BTSWEB_PUBLIC_URL=https://your-domain.example            # absolute base for URLs embedded in import codes
# PORT=5000                                              # local dev server port

# ── Database ─────────────────────────────────────────────────────────
# Unset -> SQLite dev.db next to the app. Prod: mysql+pymysql://USER:PASS@HOST/DB
# BTSWEB_DATABASE_URL=mysql+pymysql://user:password@localhost/btsweb
# BTSWEB_DB_SSL=1                                        # force TLS to the DB
# BTSWEB_DB_SSL_CA=/path/to/ca.pem                       # custom CA bundle

# ── Sign-in providers (any subset; a provider's button appears only when its pair is set) ──
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# DISCORD_CLIENT_ID=your-discord-application-id          # Discord Developer Portal → OAuth2
# DISCORD_CLIENT_SECRET=your-discord-oauth-client-secret
# GITHUB_CLIENT_ID=your-github-oauth-app-client-id       # a GitHub OAuth App allows ONE callback URL:
# GITHUB_CLIENT_SECRET=your-github-oauth-app-secret      # use a separate "(local)" app for localhost

# ── Email sign-in (magic links via Resend) ───────────────────────────
# BOTH must be set or email sign-in is disabled (the form is hidden and /api/auth/email/start answers 503) —
# except under BTSWEB_DEV_AUTH, where the link is logged and returned in the JSON instead of being mailed.
# The From domain needs Resend's SPF + DKIM records (and a _dmarc TXT) in DNS, or links land in spam.
# RESEND_API_KEY=re_...
# BTSWEB_MAIL_FROM=sign-in@blankthespire.com             # must be on a domain verified in Resend

# ── Stripe (pay-what-you-want donations + thank-you tokens) ──────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_FEE_PCT=2.9                                     # Stripe's card fee, passed to the donor as a "Card processing fee" line item
# STRIPE_FEE_FIXED_CENTS=30                              # (defaults shown; fixed donation tiers live in billing.DONATION_TIERS)

# ── LLM providers (hosted forging; BYOK users bring their own) ───────
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_API_KEY=...                                       # hosted token path: PRIMARY LLM route (glm-5.3 + gemma4:31b @ Ollama Cloud)
OPENROUTER_API_KEY=sk-or-v1-...                          # hosted token path: metered BACKUP tiers (z-ai/glm-5.3 -> z-ai/glm-5.2;
#                                                        #   stands in as the primary when OLLAMA_API_KEY is unset), and the
#                                                        #   image backend below. See generation/ollama_roles.*.json
# BTSGEN_OLLAMA_QUOTA=1                                  # cost gate: Ollama only while its subscription has room (polls
#                                                        #   ollama.com/api/usage); ceilings BTSGEN_OLLAMA_SESSION_CEILING=0.95,
#                                                        #   BTSGEN_OLLAMA_WEEKLY_CEILING=0.97; per-token billing seen -> OpenRouter
# BTSGEN_IMAGE_BACKEND=null                              # splash art backend: unset/null = none, 'procedural' = free placeholder,
#                                                        #   'openai' (OPENAI_API_KEY) or 'openrouter' (OPENROUTER_API_KEY above)
# BTSGEN_OPENROUTER_MODEL=qwen/qwen-image-3              # openrouter splash model; BTSGEN_OPENROUTER_SPRITE_MODEL for the alpha sprite
# BTSWEB_CARD_ART=1                                      # per-card portrait pack (static/forged/<id>/cards.zip); 0 = skip the step
# BTSWEB_CARD_ART_BUDGET_S=150                           # wall-clock budget for the whole pack; past it a PARTIAL zip ships
# BTSWEB_CARD_ART_MAX_USD=0.40                           # spend cap for the whole pack (metered per image); same partial-ship rule
# BTSWEB_BYOK_CARD_ART_MAX_USD=0                         # same cap for a BYOK pack billed to the USER's key; 0 (default) = uncapped
#                                                        #   (they are quoted the whole pack before forging — /api/forge-estimate)
# BTSWEB_BYOK_ART_FALLBACK=null                          # art for a BYOK key with no image API (Anthropic/Groq/…): 'null' | 'procedural'

# ── Admin / access control ───────────────────────────────────────────
# Hosted-forge allowlist + unlimited-forge emails (comma-separated). Set to YOUR admin email.
BTSWEB_HOSTED_ALLOWLIST=you@example.com
BTSWEB_UNLIMITED_EMAILS=you@example.com
# Dev auth bypass — MUST be unset/empty in production.
# BTSWEB_DEV_AUTH=
# Allow BYOK endpoints on private/loopback hosts (local Ollama) — NEVER in prod.
# BTSWEB_ALLOW_PRIVATE_URLS=

# ── Forge queue (process-local — keep gunicorn at 1 worker) ──────────
# BTSWEB_FORGE_MAX_CONCURRENT=3                          # forges running at once
# BTSWEB_FORGE_MAX_QUEUE=12                              # forges waiting in line (beyond ⇒ 503 turn-away)
# BTSWEB_FORGE_QUEUE_TIMEOUT_S=1800                      # max queue wait before giving up (token refunded)

# ── Misc knobs (all optional) ────────────────────────────────────────
# BTSWEB_CHOICE_TIMEOUT_S=120                            # interactive-forge choice timeout
# BTSWEB_GAP_LOG=/path/to/captured_gaps.jsonl            # vocabulary-gap capture log
# BTSWEB_CARD_FEEDBACK_LOG=/path/to/card_feedback.jsonl  # per-card 💬 feedback log
#   The forge reads that log back LIVE (similarity-retrieved into blueprint/card prompts), so
#   website ratings steer the next forge automatically. Generator-side source overrides:
# BTSGEN_FEEDBACK_FILE=/path/to/curated.jsonl            # default: <repo>/generation/feedback/card_feedback.jsonl
# BTSGEN_FEEDBACK_EXTRA=/a.jsonl:/b.jsonl                # extra live logs (os.pathsep-separated); default: the 💬 log above
