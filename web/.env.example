# web/.env.example — copy to web/.env and fill with your own values. NEVER commit web/.env.
# Every variable below is read by web/app.py, web/auth.py, web/billing.py, web/db.py or web/forge.py.

# ── Core Flask ───────────────────────────────────────────────────────
BTSWEB_SECRET_KEY=change-me-to-a-long-random-string     # REQUIRED in prod: app fails closed if unset when OAuth is configured
BTSWEB_SECURE_COOKIES=1                                  # 1 in production (TLS); 0 for local http
BTSWEB_BEHIND_PROXY=1                                    # 1 when behind nginx (trusts X-Forwarded-*)
BTSWEB_PUBLIC_URL=https://your-domain.example            # absolute base for URLs embedded in import codes
# PORT=5000                                              # local dev server port

# ── Database ─────────────────────────────────────────────────────────
# Unset -> SQLite dev.db next to the app. Prod: mysql+pymysql://USER:PASS@HOST/DB
# BTSWEB_DATABASE_URL=mysql+pymysql://user:password@localhost/btsweb
# BTSWEB_DB_SSL=1                                        # force TLS to the DB
# BTSWEB_DB_SSL_CA=/path/to/ca.pem                       # custom CA bundle

# ── Google OAuth (sign-in) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── Stripe (pay-what-you-want donations + thank-you tokens) ──────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# BTSWEB_DONATION_PRESETS=300,500,1000                   # preset amounts in cents

# ── LLM providers (hosted forging; BYOK users bring their own) ───────
ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_API_KEY=...                                     # hosted Ollama-mix path (see generation/ollama_roles.*.json)
# OPENROUTER_API_KEY=sk-or-v1-...                        # metered failover for the Ollama-mix path
# BTSGEN_IMAGE_BACKEND=null                              # splash art backend: unset/null = none, 'procedural' = free placeholder

# ── Admin / access control ───────────────────────────────────────────
# Hosted-forge allowlist + unlimited-forge emails (comma-separated). Set to YOUR admin email.
BTSWEB_HOSTED_ALLOWLIST=you@example.com
BTSWEB_UNLIMITED_EMAILS=you@example.com
# BTSWEB_HOSTED_DAILY_CAP=1000                           # global hosted-forge cap per day
# Dev auth bypass — MUST be unset/empty in production.
# BTSWEB_DEV_AUTH=
# Allow BYOK endpoints on private/loopback hosts (local Ollama) — NEVER in prod.
# BTSWEB_ALLOW_PRIVATE_URLS=

# ── Forge queue (process-local — keep gunicorn at 1 worker) ──────────
# BTSWEB_FORGE_MAX_CONCURRENT=3                          # forges running at once
# BTSWEB_FORGE_MAX_QUEUE=12                              # forges waiting in line (beyond ⇒ 503 turn-away)
# BTSWEB_FORGE_QUEUE_TIMEOUT_S=1800                      # max queue wait before giving up (token refunded)

# ── Misc knobs (all optional) ────────────────────────────────────────
# BTSWEB_CHOICE_TIMEOUT_S=120                            # interactive-forge choice timeout
# BTSWEB_GAP_LOG=/path/to/captured_gaps.jsonl            # vocabulary-gap capture log
# BTSWEB_CARD_FEEDBACK_LOG=/path/to/card_feedback.jsonl  # per-card 💬 feedback log
#   The forge reads that log back LIVE (similarity-retrieved into blueprint/card prompts), so
#   website ratings steer the next forge automatically. Generator-side source overrides:
# BTSGEN_FEEDBACK_FILE=/path/to/curated.jsonl            # default: <repo>/generation/feedback/card_feedback.jsonl
# BTSGEN_FEEDBACK_EXTRA=/a.jsonl:/b.jsonl                # extra live logs (os.pathsep-separated); default: the 💬 log above
