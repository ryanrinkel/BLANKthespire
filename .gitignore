# ── Secrets / local env ──────────────────────────────────────────────
# .env.* catches server-side backup copies (.env.bak, .env.predeploy-*, …)
# that would otherwise be stageable by a stray `git add -A` on the droplet.
.env
.env.*
!.env.example
*.env.local

# ── Python (generation/, web/) ───────────────────────────────────────
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
uv.lock

# ── btsgen scratch / throwaway forge output ──────────────────────────
generation/scratch/
prototype/data/generated/

# ── Locally-fetched MegaCrit reference data (NEVER commit — regenerate ──
#    via generation/reference/distill_sts2.py from the public spire-codex repo) ──
generation/reference/sts2_cards.json
generation/reference/sts2_rarity_examples.md

# ── Website local dev / server-side data ─────────────────────────────
web/dev.db*
*.sqlite
web/captured_gaps.jsonl
web/card_feedback.jsonl

# ── Droplet-local files living inside the /opt/btsweb checkout ───────
#    (btsweb's home dir IS the repo dir, so shell/service cruft lands here)
/.ssh/
/.cache/
/_backups/
/deploy.sh

# ── .NET build output ────────────────────────────────────────────────
[Bb]in/
[Oo]bj/

# ── Godot ────────────────────────────────────────────────────────────
.godot/
/android/
export_presets.cfg

# ── Local research material (never committed) ────────────────────────
/_modref/

# ── Local planning docs + generated run reports (never committed) ────
/_*_REPORT.html
/_MIGRATION_REPORT.md
docs/plans/TRIAD_PROMOTION_PLAN.md
docs/plans/EXPERIMENTAL_UNLOCKABLE_CARDS.md

# ── Machine-specific config ──────────────────────────────────────────
settings.local.json
.mcp.json
generation/ollama_roles.local.json

# ── Release artifacts + generated splash art (user content on server) ─
/release/*.zip
/web/static/releases/*.zip
/web/static/forged/

# ── OS cruft ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
