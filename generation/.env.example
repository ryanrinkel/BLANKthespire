# Copy to .env and fill in. .env is gitignored; the harness loads it automatically.
# Live card generation requires a real key (the validator/tests run without one).
ANTHROPIC_API_KEY=sk-ant-...

# Hosted token path (the release default, `--ollama`): Ollama Cloud is the PRIMARY route (glm-5.3 +
# gemma4:31b on your account).
# OLLAMA_API_KEY=...
# OpenRouter is the metered BACKUP (z-ai/glm-5.3, then z-ai/glm-5.2): arms the failover tiers, and stands in
# as the primary when OLLAMA_API_KEY is unset. Either key alone is enough to forge.
# OPENROUTER_API_KEY=sk-or-v1-...
# Cost gate (btsgen/ollama_quota.py): Ollama is used only while the subscription's included usage has room —
# GET ollama.com/api/usage is polled once a minute; at the session/weekly ceiling, or once Ollama starts
# billing per token, calls go to OpenRouter instead. Defaults shown; BTSGEN_OLLAMA_QUOTA=0 turns the gate off.
# BTSGEN_OLLAMA_SESSION_CEILING=0.95
# BTSGEN_OLLAMA_WEEKLY_CEILING=0.97
# BTSGEN_OLLAMA_QUOTA_POLL_S=60
# BTSGEN_OLLAMA_METERED_HOLD_S=3600

# Optional overrides:
# BTSGEN_MODEL=claude-opus-4-8
