# Copy to .env and fill in. .env is gitignored; the harness loads it automatically.
# Live card generation requires a real key (the validator/tests run without one).
ANTHROPIC_API_KEY=sk-ant-...

# Hosted token path (the release default, `--ollama`): OpenRouter is the PRIMARY route and is REQUIRED
# for it (z-ai/glm-5.3, falling back to z-ai/glm-5.2 on the same key).
# OPENROUTER_API_KEY=sk-or-v1-...
# Optional last-resort fallback tier (glm-5.2 @ Ollama Cloud); the tier is silently dropped when unset.
# OLLAMA_API_KEY=...

# Optional overrides:
# BTSGEN_MODEL=claude-opus-4-8
